<?xml version="1.0" encoding="utf-8"?>
<!-- Ab Android 12: Cloud-Backup und Übertragung auf ein neues Gerät. Begründung siehe backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="health_connect.xml" />
        <exclude domain="sharedpref" path="auto_backup.xml" />
        <exclude domain="file" path="gym_data_before_import.json" />
        <exclude domain="file" path="gym_data_before_reset.json" />
        <exclude domain="file" path="gym_data.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="health_connect.xml" />
        <exclude domain="sharedpref" path="auto_backup.xml" />
        <exclude domain="file" path="gym_data_before_import.json" />
        <exclude domain="file" path="gym_data_before_reset.json" />
        <exclude domain="file" path="gym_data.json.tmp" />
    </device-transfer>
</data-extraction-rules>
